<?xml version="1.0" encoding="utf-8"?>
<!-- Merged into the linker-generated manifest. 0.5.2-beta2's vcxproj references this file but its
     source export omitted it; without longPathAware, chart/audio/jacket/score paths over MAX_PATH fail
     even when Windows' LongPathsEnabled policy is on (see tests/UnicodePathTests.py, Long280/Long320). -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings xmlns:ws2="http://schemas.microsoft.com/SMI/2016/WindowsSettings">
      <ws2:longPathAware>true</ws2:longPathAware>
    </windowsSettings>
  </application>
</assembly>
